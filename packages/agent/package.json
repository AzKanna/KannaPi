{
  "name": "@kanna/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anti-corruption facade over the Pi coding-agent SDK — the ONLY package that imports @earendil-works/* (ADR-001)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@kanna/browser": "workspace:*",
    "@kanna/database": "workspace:*",
    "@kanna/security": "workspace:*",
    "@kanna/shared": "workspace:*",
    "@kanna/state": "workspace:*",
    "@kanna/traffic": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "typebox": "^1.3.28"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/server-legacy": "2.0.0",
    "zod": "4.2.0"
  }
}
